MONGODB_URI=
PORT=8000
JWT_SECRET=
JWT_EXPIRE=7d
NODE_ENV=development
MAX_FILE_SIZE=10485760
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI provider -------------------------------------------------------
# claude (default) - Anthropic Claude, requires ANTHROPIC_API_KEY, paid usage
# ollama            - local model, no API key/rate limits, needs Ollama installed
#                      (https://ollama.com) and a model pulled, e.g. `ollama pull llama3.1`
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Only needed for the related-resources feature under AI_PROVIDER=ollama (Claude uses its
# own built-in web search instead). Free tier, no card required: https://app.tavily.com
TAVILY_API_KEY=

# Caches AI provider responses to backend/.cache/ai so repeated dev/test calls with the same
# input don't re-spend API quota. Defaults to on outside production - uncomment to override.
# AI_CACHE_ENABLED=true
